# Copy to .env for local development. Never commit .env itself.
# On Railway, set these as service environment variables instead --
# do not put real values in this file.

# Mana Pool API credentials (required for any Mana Pool-integrated feature)
MANAPOOL_EMAIL=
MANAPOOL_API_TOKEN=

# Shared password gate. Leave unset locally -- localhost has no gate.
# Required on Railway before the deployed URL is safe to share.
# RETIRING: Slice 2 Stage B removes this entirely. Humans sign in at
# /login with their own account; machines use the variable below.
CARDFOUNDRY_ADMIN_PASSWORD=

# The machines' own credential -- the six Railway cron services and the
# pre-push deploy guard. Accepted by the gate ONLY for the Basic
# usernames "cron" and "hook", and it is not an account: it never signs
# anyone in and never creates a session. Kept separate from human logins
# so either can be rotated without breaking the other.
# Set it in your shell if you want the pre-push guard's live readiness
# check to run; leave it unset and only the tick-window check runs.
CARDFOUNDRY_SERVICE_PASSWORD=
