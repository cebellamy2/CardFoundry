{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(railway:*)",
      "Bash(gh:*)",
      "Bash(sqlite3:*)",
      "Bash(rm:*)",
      "Bash(crontab:*)",
      "Bash(launchctl:*)",
      "Bash(pip:*)",
      "Bash(uvicorn:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Edit(./cardfoundry.db)",
      "Write(./cardfoundry.db)",
      "Agent",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/autodev/guard.py",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
