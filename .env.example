# Copy to .env for local development. Never commit .env itself.
# On Railway, set these as service environment variables instead --
# do not put real values in this file.

# Mana Pool API credentials (required for any Mana Pool-integrated feature)
MANAPOOL_EMAIL=
MANAPOOL_API_TOKEN=

# Operator sign-in. There is NO shared site password any more -- a person
# signs in at /login with their own account, and the gate FAILS CLOSED:
# no variable you can unset will ever make the app public again.
# Create or reset an account (and clear a lockout) with:
#   cd /app && PYTHONPATH=/app /opt/venv/bin/python operator_account.py \
#     --username you@example.com
# That is also the break-glass if every credential is lost.

# The machines' own credential -- the six Railway cron services and the
# pre-push deploy guard. Accepted by the gate ONLY for the Basic usernames
# "cron" and "hook", and it is not an account: it never signs anyone in
# and never creates a session. Kept separate from human logins so either
# can be rotated without breaking the other.
# On Railway the real value lives on the CardFoundry service only; every
# cron references it as ${{CardFoundry.CARDFOUNDRY_SERVICE_PASSWORD}}.
# Set it in your shell to let the pre-push guard's live readiness check
# run; leave it unset and only the tick-window check runs (it fails open).
CARDFOUNDRY_SERVICE_PASSWORD=

# LOCAL DEVELOPMENT ONLY -- skip authentication entirely.
# Ignored on Railway, unconditionally: it is AND-ed with "not running on
# Railway", and Railway injects RAILWAY_ENVIRONMENT_NAME / RAILWAY_PROJECT_ID
# into every container itself. Setting this in Railway does nothing.
# CARDFOUNDRY_DEV_AUTH_DISABLED=1

# Shopify (phase 1). The store is read with these; WRITING additionally
# needs an explicit --confirm on publish_shopify.py AND a store on
# shopify_service.ALLOWED_WRITE_DOMAINS, so leaving these set cannot by
# itself publish anything.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional: a long-lived token from an app created before Shopify closed
# the admin-created custom app path. Left empty, the client mints its own
# 24-hour token from the client id/secret above.
SHOPIFY_ACCESS_TOKEN=
# Optional: pins the Admin API version. Defaults to 2026-10.
SHOPIFY_API_VERSION=
# REQUIRED FOR A PUBLISH, and there is no default: the location stock is
# written to. A publish refuses rather than guess which of a store's
# locations holds the cards. A bare numeric id or a full
# gid://shopify/Location/<id>. To find it:
#   ./.venv/bin/python -c "import shopify_service; print(shopify_service.locations())"
SHOPIFY_LOCATION_ID=
