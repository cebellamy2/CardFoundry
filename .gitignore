# Python virtual environment
.venv/
venv/

# Python cache files
__pycache__/
*.py[cod]

# macOS
.DS_Store

# VS Code local settings
.vscode/

# Claude Code local session/config directory
.claude/

# CardFoundry database
*.db
*.sqlite
*.sqlite3

# Secrets / API credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json

# Runtime databases, backups, journals, and SQLite sidecars
backups/
*.db-*
*.sqlite-*
*.sqlite3-*

# Test, coverage, logs, and temporary output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log
*.tmp
*.swp

# Operator-provided imports are runtime data. Previously tracked historical
# fixtures remain tracked; new production/customer exports must not be added.
imports/incoming/*

# Scratch and session output. Neither is code and neither belongs in the
# repo -- both were committed by accident in v1.190.0 by a `git add -A`
# that swept up untracked files, and untracked in v1.192.1.
# "Claude outputs/" is where the Claude Code desktop session writes
# deliverables; investigation_scratch/ is working material for a single
# investigation. Directory-level, not file-level, so the next file
# dropped in either one is covered without another .gitignore edit.
Claude outputs/
investigation_scratch/
